# Vigilo — modelo de .env de PRODUCAO (VPS Hostinger + Traefik + MySQL + Redis).
# Copie para src/.env e preencha as senhas:
#   cp src/deploy/.env.production.example src/.env
# Depois: docker compose exec app php artisan key:generate

APP_NAME=Vigilo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://vigilosecure.com

# Logs vao para o stdout/stderr do container (veja com: docker compose logs app)
# — evita conflito de posse do arquivo de log entre web (www-data) e workers.
LOG_CHANNEL=stderr

# Hosts sao os NOMES dos containers da infra compartilhada (nao 127.0.0.1)
DB_CONNECTION=mysql
DB_HOST=data-mysql-1
DB_PORT=3306
DB_DATABASE=vigilo
DB_USERNAME=vigilo
DB_PASSWORD=senha_forte_sem_simbolos

REDIS_HOST=data-redis-1
REDIS_PASSWORD=A_SENHA_DO_REDIS
REDIS_PORT=6379

# Redis para cache, fila e sessao (a infra ja tem o data-redis-1)
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true

# Consumo da BrasilAPI (entrada de dados KYB)
CNPJ_DRIVER=brasilapi
CNPJ_BRASILAPI_URL=https://brasilapi.com.br/api/cnpj/v1
CNPJ_TIMEOUT=10
CNPJ_TRIES=3
CNPJ_RETRY_BACKOFF_MS=500
CNPJ_THROTTLE_PER_MINUTE=20

# API publica de CNPJ (Vigilo servindo o fornecedor)
CNPJ_API_RATE_PER_MINUTE=30
CNPJ_API_HISTORY_LIMIT=50

# Base CNPJ propria (V2) — PostgreSQL numa VM da Oracle Cloud, alimentado pelo
# pipeline de dump (docs/vigilo-cnpj-oracle-migracao.md). Papel NAO-superuser
# vigilo_app: a senha e o CNPJ_APP_PASSWORD de ~/cnpj/.env na VM; a CA vem de
# /data/certs/ca.crt na VM, copiada para src/storage/app/private/cnpj-db-ca.crt.
CNPJ_DB_HOST=159.112.186.240
CNPJ_DB_PORT=5432
CNPJ_DB_DATABASE=cnpj
CNPJ_DB_USERNAME=vigilo_app
CNPJ_DB_PASSWORD=
CNPJ_DB_SSLMODE=verify-full
CNPJ_DB_SSLROOTCERT=/var/www/storage/app/private/cnpj-db-ca.crt
CNPJ_DB_CONNECT_TIMEOUT=5

# E-mails de alerta (opcional) — preencha se for notificar por e-mail
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=alertas@vigilosecure.com

# Risco — sancoes da CGU via Portal da Transparencia (opcional).
# Chave gratuita: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
# Sem a chave, o painel de risco degrada ("integracao nao configurada").
PORTAL_TRANSPARENCIA_API_KEY=
# PORTAL_TRANSPARENCIA_TIMEOUT=10
# RISCO_CACHE_TTL=720
